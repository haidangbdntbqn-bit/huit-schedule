# ===== Ứng dụng =====
APP_NAME="HUIT Schedule Hub"
APP_DEBUG=false
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ===== Kết nối Database (MySQL) =====
# Laragon / XAMPP : DB_PORT=3306, DB_USER=root, DB_PASS=
# MAMP (macOS)    : DB_PORT=8889, DB_USER=root, DB_PASS=root
DB_HOST=localhost
DB_PORT=3306
DB_NAME=huit_db
DB_USER=root
DB_PASS=

# ===== Tài khoản quản trị (Phòng Đào tạo) =====
ADMIN_EMAIL=admin@huit.edu.vn
ADMIN_PASSWORD=admin123

# Mật khẩu mặc định khi tạo / đặt lại tài khoản giảng viên
TEACHER_DEFAULT_PASSWORD=123456

# ===== Tham số thuật toán xếp lịch =====
# Số tiết tối thiểu phải cách nhau khi giảng viên đổi cơ sở trong cùng buổi
TRAVEL_GAP_PERIODS=1
# Khoảng trống >= N tiết giữa 2 lớp trong cùng buổi bị coi là "khoảng trống chết"
DEAD_GAP_PERIODS=3
# Số tiết tối đa / ngày / giảng viên trước khi cảnh báo
MAX_PERIODS_PER_DAY=10
# Cho phép gợi ý xếp lịch vào Chủ nhật
ALLOW_SUNDAY=false
